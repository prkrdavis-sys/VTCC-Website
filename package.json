{
  "name": "vtcc-website",
  "private": true,
  "version": "0.1.0",
  "description": "Planning documents and static mockup for the VTCC website.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "dev:redesign": "npm run dev --prefix ../vtcc-redesign",
    "scrape:seo": "node scripts/scrape-seo.mjs",
    "build": "node scripts/update-routes.mjs && node scripts/patch-resources.mjs && node scripts/bundle-analytics.mjs && node scripts/build-prototype.mjs && node scripts/build-page-copy.mjs",
    "build:analytics": "node scripts/bundle-analytics.mjs",
    "build:prototype": "node scripts/build-prototype.mjs",
    "build:copy": "node scripts/build-page-copy.mjs",
    "generate:es": "node scripts/generate-es-locale.mjs",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run",
    "preview:cf": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "wrangler": "^4.148.0"
  }
}
